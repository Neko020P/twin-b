#!/usr/bin/env python3
"""
Distributed Mesa simulation using PyTorch process group for sync/collect.
"""

import random
from mesa import Agent

class BaseAgent(Agent):
    def __init__(self, unique_id, model):
        super().__init__(unique_id, model)
        
    def log_step(self, role, room, temp=None, action=None):
        occupant_count = sum(
            1 for a in self.model.schedule.agents
            if hasattr(a, "current_room") and a.current_room == room
        )
    
        entry = {
            "step": self.model.current_step,
            "datetime": self.model.get_datetime(),
            "agent_id": self.unique_id,
            "agent_type": role,
            "room": room,
            "occupant_count": occupant_count   
        }
        if temp is not None:
            entry["current_temp"] = round(temp,2)
        if action is not None:
            entry["action"] = action
        if role != "policy":
            entry["comfort_level"] = round(abs(temp - self.preferred_temp),2) if temp is not None else None
            entry["using_ac"] = temp > self.preferred_temp if temp is not None else None
            entry["preferred_temp"] = round(self.preferred_temp,2)
        else:
            entry["preferred_temp"] = round(self.preferred_temp,2)
    
        self.model.agent_results.append(entry)

    # def log_step(self, role, room, temp=None, action=None):
