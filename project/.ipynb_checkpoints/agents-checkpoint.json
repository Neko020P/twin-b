class PolicyAgent(BaseAgent):
    def __init__(self, unique_id, model, room):
        super().__init__(unique_id, model)
        self.role = "policy"
        self.current_room = room
        self.max_delta = 3
        self.preferred_temp = 25.0

    def step(self):
        temp = self.model.get_current_temp(self.current_room)
        if temp is not None:
            lower = self.preferred_temp - self.max_delta
            upper = self.preferred_temp + self.max_delta
            if temp < lower:
                action = "heat_on"   
            elif temp > upper:
                action = "cool_on"  
            else:
                action = "hold"
            self.log_step(self.role, self.current_room, temp=temp, action=action)
